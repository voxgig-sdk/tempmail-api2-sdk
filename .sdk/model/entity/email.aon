# Entity: email

main: kit: entity: email: {

  alias: field: {}

  fields: [
    {
      name: "attachments"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "body"
      req: false
      short: "Email body content"
      type: "`$STRING`"
    }
    {
      name: "date"
      req: false
      short: "Timestamp when email was received"
      type: "`$STRING`"
    }
    {
      name: "from"
      req: false
      short: "Sender email address"
      type: "`$STRING`"
    }
    {
      name: "html"
      req: false
      short: "HTML version of email body"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the email"
      type: "`$STRING`"
    }
    {
      name: "subject"
      req: false
      short: "Email subject"
      type: "`$STRING`"
    }
    {
      name: "to"
      req: false
      short: "Recipient email address"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "email"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "email_id"
                orig: "email_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "token"
                orig: "token"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/inbox/{token}/{emailId}"
          parts: [
            "inbox"
            "{token}"
            "{email_id}"
          ]
          rename: {
            param: {
              emailId: "email_id"
            }
          }
          select: {
            exist: [
              "email_id"
              "token"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "email_id"
                orig: "email_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "token"
                orig: "token"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/inbox/{token}/{emailId}"
          parts: [
            "inbox"
            "{token}"
            "{email_id}"
          ]
          rename: {
            param: {
              emailId: "email_id"
            }
          }
          select: {
            exist: [
              "email_id"
              "token"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "inbox"
      ]
    ]
  }



}

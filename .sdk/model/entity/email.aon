# Entity: email

main: kit: entity: email: {

  alias: field: {}

  fields: [
    {
      name: "attachments"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "body"
      req: false
      short: "Email body content"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "date"
      req: false
      short: "Timestamp when email was received"
      type: "`$STRING`"
    }
    {
      format: "email"
      name: "from"
      req: false
      short: "Sender email address"
      type: "`$STRING`"
    }
    {
      name: "html"
      req: false
      short: "HTML version of email body"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the email"
      type: "`$STRING`"
    }
    {
      name: "subject"
      req: false
      short: "Email subject"
      type: "`$STRING`"
    }
    {
      format: "email"
      name: "to"
      req: false
      short: "Recipient email address"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
    parts: [
      "token"
      "email_id"
    ]
    sep: "/"
  }

  name: "email"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "email_id"
                orig: "email_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "token"
                orig: "token"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/inbox/{token}/{emailId}"
          rename: {
            param: {
              emailId: "email_id"
            }
          }
          segments: [
            {
              lit: "inbox"
            }
            {
              var: "token"
            }
            {
              var: "email_id"
            }
          ]
          select: {
            exist: [
              "email_id"
              "token"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "email_id"
                orig: "email_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "token"
                orig: "token"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/inbox/{token}/{emailId}"
          rename: {
            param: {
              emailId: "email_id"
            }
          }
          segments: [
            {
              lit: "inbox"
            }
            {
              var: "token"
            }
            {
              var: "email_id"
            }
          ]
          select: {
            exist: [
              "email_id"
              "token"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "inbox"
      ]
    ]
  }



}
